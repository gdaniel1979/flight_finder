# Flight Finder – Konfiguráció
# ================================

# Keresési beállítások
search:
  origin: "BUD"               # Kiindulási repülőtér IATA kódja
  morning_before: 9           # Reggeli határ: ennyi óra ELŐTT kell indulni (0-12)
  evening_after: 18           # Esti határ: ennyi óra UTÁN kell visszaindulni (12-23)
  search_days: 30             # Hány napra előre keresünk (1-90)
  currency: "EUR"             # Pénznem (EUR, HUF, GBP, stb.) – minden légitársaságra
  max_price: 80               # Max összár oda-vissza, minden légitársaságra (null = nincs limit)

  # Út típusa:
  #   "daytrip"  = egynapos oda-vissza (reggel oda, este vissza, ugyanaznap)
  #   "multiday" = többnapos út (reggel oda az első napon, este vissza az utolsón)
  trip_mode: "daytrip"
  min_nights: 2               # csak multiday módban: legkevesebb éjszaka
  max_nights: 4               # csak multiday módban: legtöbb éjszaka

  # Célállomások szűrése (opcionális)
  # Ha üres vagy nincs megadva, az összes elérhető célállomást keresi
  # destinations: ["BCN", "BGY", "STN", "MXP"]
  destinations: []

  # Kizárt célállomások (opcionális)
  # Ezeket a célállomásokat kihagyja a keresésből
  exclude_destinations: [] # ["AMM", "BHX", "BRS", "EDI", "LIS", "LPA", "LPL", "MAD", "MAN", "NCL", "OPO", "RAK", "STN", "TFS"]

# Légitársaságok beállításai
# Minden légitársaságnál ugyanaz állítható:
#   enabled      – részt vesz-e a keresésben
#   max_price    – saját oda-vissza árlimit (null = a search.max_price érvényes)
#   destinations – "all" (a légitársaság minden útvonala) vagy IATA kódok listája
airlines:
  ryanair:
    enabled: true
    max_price: null
    destinations: "all"
    request_delay: 0.8        # Várakozás két keresés között (másodperc)
    max_retries: 3            # Újrapróbálkozások száma 429/5xx válasznál

  # A többi légitársaság járatait a Google Flights-ról olvassuk (fast-flights csomag kell
  # hozzá). Egy kérés = egy útvonal, egy nap, egy irány, ezért tartsd rövidre a listákat;
  # a több légitársaság által is repült útvonal csak egyszer számít. Ha a Google korlátoz,
  # ezek keresése aznapra leáll (lásd CLAUDE.md).
  wizzair:
    enabled: false
    max_price: null
    destinations: ["FCO", "NAP"]

  easyjet:
    enabled: false
    max_price: null
    destinations: ["LGW", "SEN", "CDG", "LYS", "NTE", "BOD", "GVA", "BSL"]

  eurowings:
    enabled: false
    max_price: null
    destinations: ["DUS", "CGN", "HAM", "STR"]

  jet2:
    enabled: false
    max_price: null
    destinations: ["MAN", "BHX", "EMA", "LBA"]

  norwegian:
    enabled: false
    max_price: null
    destinations: ["CPH", "OSL", "ARN"]

  pegasus:
    enabled: false
    max_price: null
    destinations: ["SAW"]

  ajet:
    enabled: false
    max_price: null
    destinations: ["SAW"]

  airbaltic:
    enabled: false
    max_price: null
    destinations: ["RIX"]

# A Google Flights-ról olvasott légitársaságok közös beállítása
google_flights:
  request_delay: 3            # Várakozás két Google kérés között (másodperc)

# Email értesítés (Brevo API)
email:
  enabled: true               # true-ra állítsd, ha be akarod kapcsolni
  brevo_api_key: "xkeysib-XXX"            # Brevo API kulcs
  sender_email: "XXX"             # Feladó email cím
  sender_name: "Flight Finder"
  recipient_emails:                                  # Címzett email címek (több is megadható)
    - "XXX"
    - "YYY"

# Logging
logging:
  level: "INFO"               # DEBUG, INFO, WARNING, ERROR
  log_file: "logs/flight_finder.log"                 # Eredmények (legújabb futás felül)
  max_result_runs: 365        # Ennyi legutóbbi futás marad az eredmény-logban (null = mind)
  debug_log_file: "logs/flight_finder_debug.log"     # Diagnosztika: kérések, hibák (forgatva)
  max_log_size_mb: 10         # A diagnosztikai log forgatási mérete
  backup_count: 5             # Ennyi régi diagnosztikai logot tart meg
