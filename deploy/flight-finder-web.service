# Flight Finder beállító webapp – systemd unit
#
# Az app csak a gépen belül hallgat (127.0.0.1:8503); kívülről az nginx teszi elérhetővé
# HTTPS-en, a https://134-209-226-208.sslip.io/flight-finder/ címen (deploy/nginx-flight-finder.conf).
# A 8503-as portot a tűzfalon NEM kell megnyitni.
#
# Telepítés / frissítés:
#   sudo cp deploy/flight-finder-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl restart flight-finder-web
#
# Az appban nincs belépés: aki ismeri a címet, az szerkesztheti a beállításokat.

[Unit]
Description=Flight Finder Settings Streamlit App
After=network.target

[Service]
User=gdaniel1979
WorkingDirectory=/home/gdaniel1979/my_projects/flight_finder_ryanair
ExecStart=/home/gdaniel1979/.local/bin/streamlit run webapp.py --server.port 8503 --server.address 127.0.0.1 --server.headless true --server.baseUrlPath flight-finder
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
